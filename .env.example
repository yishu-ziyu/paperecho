# 纸上的回声 · MiniMax（开口主路径，项目内唯一配置源）
# 任意 npm 脚本 / tsx / dev 都读这一份，不吃宿主 ANTHROPIC_*。
MINIMAX_CN_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# Node fetch 默认不走系统代理。本机 Clash / V2Ray 填这个，否则开口出不去。
# HTTPS_PROXY=http://127.0.0.1:7897

# 现场短预算现搜 + npm run collect（原文不进游戏）
# FIRECRAWL_API_KEY=
# ANYSEARCH_API_KEY=
# PAPER_ECHO_LIVE=0   # 关掉现场爬，只用库
# PAPER_ECHO_LIVE_MS=4000

# 备选：AI PING OpenAI 兼容端点。切过去时设 PAPER_ECHO_LLM=aiping
# AI_PING_API_KEY=
# PAPER_ECHO_LLM=minimax
